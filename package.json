{
  "name": "next-up",
  "version": "0.2.0",
  "description": "Obsidian plugin: tasks as notes, shown in filtered, nested, drag-and-drop lists.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test 'test/*.test.ts'",
    "kb": "node src/kb/cli.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "obsidian-plugin", "tasks", "productivity"],
  "author": "Solal Stern",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
